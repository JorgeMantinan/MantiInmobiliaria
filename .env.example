# Copia este archivo a .env (raíz del monorepo) y rellena los valores.
# .env está en .gitignore: NUNCA se commitea. Estos son sólo ejemplos ficticios.

# --- Obligatorios ---
# OAuth2 de Google (console.cloud.google.com > credenciales OAuth)
# Formato del client id: <id>.apps.googleusercontent.com / del client secret: GOCSPX-<cadena>
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Secreto de firma JWT HS256. Mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
# URL del frontend (redirección tras login con Google)
FRONTEND_URL=http://localhost:3000
# Allowlist de orígenes CORS permitidos (separados por comas). Nunca '*'.
ALLOWED_ORIGINS=http://localhost:3000

# --- Opcionales (defaults entre paréntesis) ---
# Exposición de springdoc (Swagger UI / api-docs). Sin definir: true;
# con perfil prod el default es false (application-prod.yml).
# SPRINGDOC_ENABLED=
# SameSite de la cookie de refresh. En prod cross-site hará falta None (+ Secure).
COOKIE_SAMESITE=Lax          # (Lax)
COOKIE_SECURE=false          # (false) → true en producción con HTTPS
AUTH_RATE_LOGIN_PER_MINUTE=10     # (10)
AUTH_RATE_REGISTER_PER_MINUTE=5   # (5)
DB_URL=jdbc:postgresql://localhost:5433/manti   # (localhost:5433)
DB_USER=manti               # (manti)
DB_PASSWORD=manti_dev       # (manti_dev, sólo dev)
# FASE 7 — job diario de purga de refresh_tokens a las 04:17 (issue #8).
# Con false el job no se crea; la purga manual sigue disponible.
# PURGAS_ENABLED=true       # (true)
# FASE 7 — endpoints del actuator expuestos (issue #25). El default es
# health,info,metrics,prometheus y SÓLO /actuator/health es anónimo (el resto
# pide rol ADMIN). En el perfil prod el default es health,info.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
# Export de métricas a Prometheus en prod (application-prod.yml): apagado salvo
# que se scrape; para activarlo hay que subir también la exposure de arriba.
# PROMETHEUS_EXPORT_ENABLED=false   # (false en prod)
# Tamaño del pool de conexiones Hikari: NO subirlo sin mirar antes
# hikaricp.connections.pending en /actuator/metrics (issue #31).
# HIKARI_MAXIMUM_POOL_SIZE=10       # (10)

# --- FASE 5 — notificaciones (outbox transaccional) ---
# Interruptor global del ENVÍO: con false (default) las filas quedan PENDIENTES
# y no se llama a ningún proveedor.
# NOTIFICACIONES_ENABLED=false
# Token del bot de Telegram (https://t.me/BotFather) y chat_id del grupo.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Clave de la API de Brevo (ex-Sendinblue) para los emails transaccionales.
# BREVO_API_KEY=
# Remitente de los emails de notificación.
# NOTIF_EMAIL_FROM=

# --- FASE 5 — rate limit de las rutas públicas (ventana de 1 hora por IP) ---
# AUTH_RATE_SOLICITUDES_PER_HOUR=10
# AUTH_RATE_REGISTRO_PROFESIONAL_PER_HOUR=5

# --- FASE P2 — rate limit de sesiones, listado público y swipes (60 s por IP) ---
# Issues #17 y #22. Sólo hace falta definirlos para cambiar el default.
# AUTH_RATE_REFRESH_PER_MINUTE=60          # (60) rotación de refresh token
# AUTH_RATE_OAUTH2_TOKEN_PER_MINUTE=20     # (20) canje del código de Google
# AUTH_RATE_INMUEBLES_PER_MINUTE=60        # (60) GET /api/v1/inmuebles (listado)
# AUTH_RATE_SWIPES_PER_MINUTE=120          # (120) POST /api/v1/swipes
# AUTH_RATE_DECK_PER_MINUTE=60             # (60) GET /api/v1/swipes/deck
# AUTH_RATE_FAVORITOS_PER_MINUTE=60        # (60) GET /api/v1/swipes/favoritos
