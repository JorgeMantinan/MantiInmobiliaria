# Copia este archivo a .env (raíz del monorepo) y rellena los valores.
# .env está en .gitignore: NUNCA se commitea. Estos son sólo ejemplos ficticios.

# --- Obligatorios ---
# OAuth2 de Google (console.cloud.google.com > credenciales OAuth)
# Formato del client id: <id>.apps.googleusercontent.com / del client secret: GOCSPX-<cadena>
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Secreto de firma JWT HS256. Mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
# URL del frontend (redirección tras login con Google)
FRONTEND_URL=http://localhost:3000
# Allowlist de orígenes CORS permitidos (separados por comas). Nunca '*'.
ALLOWED_ORIGINS=http://localhost:3000

# --- Opcionales (defaults entre paréntesis) ---
# Exposición de springdoc (Swagger UI / api-docs). Sin definir: true;
# con perfil prod el default es false (application-prod.yml).
# SPRINGDOC_ENABLED=
# SameSite de la cookie de refresh. En prod cross-site hará falta None (+ Secure).
COOKIE_SAMESITE=Lax          # (Lax)
COOKIE_SECURE=false          # (false) → true en producción con HTTPS
AUTH_RATE_LOGIN_PER_MINUTE=10     # (10)
AUTH_RATE_REGISTER_PER_MINUTE=5   # (5)
DB_URL=jdbc:postgresql://localhost:5433/manti   # (localhost:5433)
DB_USER=manti               # (manti)
DB_PASSWORD=manti_dev       # (manti_dev, sólo dev)

# --- FASE 5 — notificaciones (outbox transaccional) ---
# Interruptor global del ENVÍO: con false (default) las filas quedan PENDIENTES
# y no se llama a ningún proveedor.
# NOTIFICACIONES_ENABLED=false
# Token del bot de Telegram (https://t.me/BotFather) y chat_id del grupo.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Clave de la API de Brevo (ex-Sendinblue) para los emails transaccionales.
# BREVO_API_KEY=
# Remitente de los emails de notificación.
# NOTIF_EMAIL_FROM=

# --- FASE 5 — rate limit de las rutas públicas (ventana de 1 hora por IP) ---
# AUTH_RATE_SOLICITUDES_PER_HOUR=10
# AUTH_RATE_REGISTRO_PROFESIONAL_PER_HOUR=5
