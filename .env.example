# Copia este archivo a .env (raÃ­z del monorepo) y rellena los valores.
# .env estÃ¡ en .gitignore: NUNCA se commitea. Estos son sÃ³lo ejemplos ficticios.

# --- Obligatorios ---
# OAuth2 de Google (console.cloud.google.com > credenciales OAuth)
# Formato del client id: <id>.apps.googleusercontent.com / del client secret: GOCSPX-<cadena>
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Secreto de firma JWT HS256. MÃ­nimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
# URL del frontend (redirecciÃ³n tras login con Google)
FRONTEND_URL=http://localhost:3000
# Allowlist de orÃ­genes CORS permitidos (separados por comas). Nunca '*'.
ALLOWED_ORIGINS=http://localhost:3000

# --- Opcionales (defaults entre parÃ©ntesis) ---
# ExposiciÃ³n de springdoc (Swagger UI / api-docs). Sin definir: true;
# con perfil prod el default es false (application-prod.yml).
# SPRINGDOC_ENABLED=
# SameSite de la cookie de refresh. En prod cross-site harÃ¡ falta None (+ Secure).
COOKIE_SAMESITE=Lax          # (Lax)
COOKIE_SECURE=false          # (false) â†’ true en producciÃ³n con HTTPS
# --- Issues #9 y #6 — endurecimiento de prod (application-prod.yml) ---
# Cookie de refresh: en prod el default es __Host-refresh_token con Path=/
# (prefijo __Host- contra inyecciÃ³n desde subdominios hermanos). Al desplegar
# el cambio, las sesiones abiertas con la cookie antigua se reloguean una vez.
# COOKIE_NAME=__Host-refresh_token   # (prod) revertir con refresh_token
# COOKIE_PATH=/                      # (prod) revertir con /api/v1/auth
# HSTS (Strict-Transport-Security, includeSubDomains, 1 aÃ±o). SÃ³lo prod emite
# la cabecera; HSTS_ENABLED=true es el default del perfil prod.
# HSTS_MAX_AGE_SEGUNDOS=31536000     # (31536000 = 1 aÃ±o)
# Actuator en prod: SÃ“LO /actuator/health por defecto (issue #6); el resto
# exige rol ADMIN ademÃ¡s de abrirse con MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# ProtecciÃ³n del login (#10 backoff por cuenta, #5 ventana sha256(IP+email)):
# AUTH_LOGIN_PROTECTION_ENABLED=true  # (true)
# AUTH_LOGIN_FALLOS_BACKOFF=5         # (5) fallos antes del backoff 1,2,4,8... min
# AUTH_LOGIN_PARES_POR_MINUTO=5       # (5) intentos/min por combinaciÃ³n IP+email
# ComprobaciÃ³n HIBP de passwords (#10, k-anonymity, sin API key; fail open):
# AUTH_HIBP_ENABLED=true              # (true)
# Guarda de arranque (#5): en prod, FORWARD_HEADERS_STRATEGY=none rechaza el
# arranque (el rate limit por IP y HSTS dependen del proxy de Vercel).
# FORWARD_HEADERS_STRATEGY=framework  # (framework en prod; no definir en dev)
AUTH_RATE_LOGIN_PER_MINUTE=10     # (10)
AUTH_RATE_REGISTER_PER_MINUTE=5   # (5)
DB_URL=jdbc:postgresql://localhost:5433/manti   # (localhost:5433)
DB_USER=manti               # (manti)
DB_PASSWORD=manti_dev       # (manti_dev, sÃ³lo dev)
# FASE 7 â€” job diario de purga de refresh_tokens a las 04:17 (issue #8).
# Con false el job no se crea; la purga manual sigue disponible.
# PURGAS_ENABLED=true       # (true)
# FASE 7 â€” endpoints del actuator expuestos (issue #25). El default es
# health,info,metrics,prometheus y SÃ“LO /actuator/health es anÃ³nimo (el resto
# pide rol ADMIN). En el perfil prod el default es health,info.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
# Export de mÃ©tricas a Prometheus en prod (application-prod.yml): apagado salvo
# que se scrape; para activarlo hay que subir tambiÃ©n la exposure de arriba.
# PROMETHEUS_EXPORT_ENABLED=false   # (false en prod)
# TamaÃ±o del pool de conexiones Hikari: NO subirlo sin mirar antes
# hikaricp.connections.pending en /actuator/metrics (issue #31).
# HIKARI_MAXIMUM_POOL_SIZE=10       # (10)

# --- FASE 5 â€” notificaciones (outbox transaccional) ---
# Interruptor global del ENVÃO: con false (default) las filas quedan PENDIENTES
# y no se llama a ningÃºn proveedor.
# NOTIFICACIONES_ENABLED=false
# Token del bot de Telegram (https://t.me/BotFather) y chat_id del grupo.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Clave de la API de Brevo (ex-Sendinblue) para los emails transaccionales.
# BREVO_API_KEY=
# Remitente de los emails de notificaciÃ³n.
# NOTIF_EMAIL_FROM=

# --- FASE 5 â€” rate limit de las rutas pÃºblicas (ventana de 1 hora por IP) ---
# AUTH_RATE_SOLICITUDES_PER_HOUR=10
# AUTH_RATE_REGISTRO_PROFESIONAL_PER_HOUR=5

# --- FASE P2 â€” rate limit de sesiones, listado pÃºblico y swipes (60 s por IP) ---
# Issues #17 y #22. SÃ³lo hace falta definirlos para cambiar el default.
# AUTH_RATE_REFRESH_PER_MINUTE=60          # (60) rotaciÃ³n de refresh token
# AUTH_RATE_OAUTH2_TOKEN_PER_MINUTE=20     # (20) canje del cÃ³digo de Google
# AUTH_RATE_INMUEBLES_PER_MINUTE=300       # (300) GET /api/v1/inmuebles (listado; IP compartida=NAT)
# AUTH_RATE_SWIPES_PER_MINUTE=120          # (120) POST /api/v1/swipes
# AUTH_RATE_DECK_PER_MINUTE=300            # (300) GET /api/v1/swipes/deck
# AUTH_RATE_FAVORITOS_PER_MINUTE=300       # (300) GET /api/v1/swipes/favoritos
