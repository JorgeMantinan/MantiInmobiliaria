# URL base de la API Spring Boot (frontend).
# En local: http://localhost:8080
# En Vercel (producción): definir NEXT_PUBLIC_API_URL en
#   Project → Settings → Environment Variables → Production/Preview
#   (p. ej. https://api.tudominio.com) y redeployar: el valor se inyecta en
#   build-time, así que un cambio de variable requiere nuevo build.
NEXT_PUBLIC_API_URL=http://localhost:8080
