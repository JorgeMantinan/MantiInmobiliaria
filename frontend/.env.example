# URL base de la API Spring Boot (frontend).
# En local: http://localhost:8080
# En Vercel (producción): definir NEXT_PUBLIC_API_URL en
#   Project → Settings → Environment Variables → Production/Preview
#   (p. ej. https://api.tudominio.com) y redeployar: el valor se inyecta en
#   build-time, así que un cambio de variable requiere nuevo build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clave de tiles CARTO para los mapas (tarjeta estática y ficha interactiva).
# NEXT_PUBLIC_* = clave PÚBLICA: viaja en el bundle del navegador, por eso hay
# que restringirla por dominio en carto.com (Account → API Keys → HTTP referrer).
# Nunca subir el valor real al repositorio; cada desarrollador la pone en .env.local.
NEXT_PUBLIC_CARTO_KEY=cb1_tu_key_publica_aqui
